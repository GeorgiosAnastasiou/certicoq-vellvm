Definition intxy (x y w : nat) (l : list nat):= 
  let f := (fix aux l acc :=
     match l with
     | [] => acc  
     | z :: zs => aux zs (z :: x :: y :: w :: acc)
     end) in
  f l [].

Definition intxy' (x y w : nat) (l : list nat) := 
  let f := (fix aux l :=
     match l with
     | [] => []  
     | z :: zs => z :: x :: y :: w :: aux zs
     end) in
  f l.

