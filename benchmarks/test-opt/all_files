value calls(struct thread_info* tinfo, value clos, unsigned int n, ...)
{
  value v = clos;
  va_list args;
  va_start(args, n);

  for(; n != 0; n--) {
    v = va_arg(args, unsigned long long);
    clos = call(tinfo, clos, v);
  }
  va_end(args);
  return clos;
}


