  version: "dev+8.20"
  synopsis: "A Verified Compiler for Gallina, Written in Gallina"
  maintainer: "The CertiCoq Team"
  authors: [
    "Andrew Appel"
    "Yannick Forster"
    "Anvay Grover"
    "Joomy Korkut"
    "John Li"
    "Zoe Paraskevopoulou"
    "Matthieu Sozeau"
    "Matthew Weaver"
    "Abhishek Anand"
    "Greg Morrisett"
    "Randy Pollack"
    "Olivier Savary Belanger"
  ]
  license: "MIT"
  homepage: "https://certicoq.org/"
  bug-reports: "https://github.com/CertiCoq/certicoq/issues"
  depends: [
    "ocaml" {>= "4.13"}
    "conf-clang"
    "stdlib-shims"
    "coq" {>= "8.20" & < "8.21~"}
    "coq-compcert" {= "3.13.1"}
    "coq-equations" {= "1.3.1+8.20"}
    "coq-metacoq-erasure-plugin" {= "1.3.4+8.20"}
    "coq-metacoq-safechecker-plugin" {= "1.3.4+8.20"}
    "coq-ext-lib" {>= "0.12"}
  ]
  build: [
    ["bash" "./configure.sh"]
    [make "all"]
    [make "plugins"]
    [make "bootstrap"]
  ]
  install: [make "install"]
  dev-repo: "git+https://github.com/CertiCoq/certicoq"
  url {
    src: "git+https://github.com/CertiCoq/certicoq.git#coq-8.20"
  }
}
